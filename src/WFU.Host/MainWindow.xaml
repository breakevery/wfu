<Window x:Class="WFU.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:behaviors="clr-namespace:WFU.Host.Behaviors"
        xmlns:views="clr-namespace:WFU.Host.Views"
        Title="WFU — WebView For Unity" Height="720" Width="1200"
        Loaded="MainWindow_Loaded"
        Closing="OnWindowClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 菜单栏 -->
        <Menu Grid.Row="0">
            <MenuItem x:Name="MenuFile" Header="File">
                <MenuItem x:Name="MenuFileNew" Header="New" Command="{Binding NewFileCommand}"/>
                <MenuItem x:Name="MenuFileOpen" Header="Open" Command="{Binding OpenFileCommand}"/>
                <MenuItem x:Name="MenuFileSave" Header="Save" Command="{Binding SaveFileCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuFileExit" Header="Exit" Command="{Binding ExitAppCommand}"/>
            </MenuItem>
            <MenuItem x:Name="MenuEdit" Header="Edit">
                <MenuItem Header="Undo" Command="{Binding UndoCommand}"/>
                <MenuItem Header="Redo" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="Cut" Command="{Binding CutCommand}"/>
                <MenuItem Header="Copy" Command="{Binding CopyCommand}"/>
                <MenuItem Header="Paste" Command="{Binding PasteCommand}"/>
            </MenuItem>
            <MenuItem x:Name="MenuView" Header="View">
                <MenuItem Header="Toggle Left Panel" Command="{Binding ToggleLeftPanelCommand}"/>
                <MenuItem Header="Toggle Right Panel" Command="{Binding ToggleRightPanelCommand}"/>
                <Separator/>
                <MenuItem x:Name="MenuViewTestBridge" Header="Test C# → JS" Click="TestCSharpToJs_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuHelp" Header="Help">
                <MenuItem x:Name="MenuHelpAbout" Header="About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Row 1: 工具栏 -->
        <ToolBar Grid.Row="1">
            <Button x:Name="ToolbarNew" Content="New" Command="{Binding NewFileCommand}"/>
            <Button x:Name="ToolbarOpen" Content="Open" Command="{Binding OpenFileCommand}"/>
            <Button x:Name="ToolbarSave" Content="Save" Command="{Binding SaveFileCommand}"/>
            <Separator/>
            <Button x:Name="ToolbarPreview" Content="Preview" Click="Preview_Click"/>
            <Button x:Name="ToolbarExport" Content="Export"/>
            <Separator/>
            <Button Content="Bridge Test" Click="BridgeTest_Click"/>
        </ToolBar>

        <!-- Row 2: 主内容区（三列） -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Col 0: 左侧文件树（暂留空） -->
            <TreeView x:Name="LeftPanel"
                      Grid.Column="0"
                      BorderThickness="0,0,1,0"
                      BorderBrush="#DDDDDD"/>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Col 1: AvalonEdit 编辑器 -->
            <avalonedit:TextEditor x:Name="Editor"
                                   Grid.Column="2"
                                   ShowLineNumbers="True"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   behaviors:EditorTextBinding.Text="{Binding EditorContent, Mode=OneWay}"
                                   TextChanged="Editor_TextChanged"/>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Col 2: 右侧预览区（WebView2 宿主） -->
            <views:WebViewHost x:Name="RightWebView" Grid.Column="4"/>
        </Grid>

        <!-- Row 3: 分隔条 -->
        <GridSplitter Grid.Row="3"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Row 4: 状态栏 -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="已保存"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                    <Setter Property="Text" Value="● 已修改"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="行: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentLine}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="列: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentColumn}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
