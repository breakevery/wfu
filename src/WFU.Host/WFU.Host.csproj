<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WFU.Core\WFU.Core.csproj" />
    <ProjectReference Include="..\WFU.Bridge\WFU.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\test-bridge.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Templates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- M5-4: publish 后自动复制 Plugins 到输出目录 -->
  <Target Name="CopyPluginsToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_PluginSourceDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\net8.0-windows\Plugins</_PluginSourceDir>
    </PropertyGroup>

    <ItemGroup>
      <_PluginFiles Include="$(_PluginSourceDir)\**\*.*" />
    </ItemGroup>

    <Message Text="Copying @(_PluginFiles->Count()) plugin files to $(PublishDir)Plugins\ ..." Importance="high" />

    <Copy SourceFiles="@(_PluginFiles)"
          DestinationFiles="@(_PluginFiles->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_PluginSourceDir)')" />

    <Warning Text="插件源目录不存在：$(_PluginSourceDir) —— 请先编译插件再 publish"
             Condition="!Exists('$(_PluginSourceDir)')" />
  </Target>

</Project>
